{
  "uid": "dealstream-ops",
  "title": "Dealstream operations",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Accepted items/s by retailer",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (retailer) (rate(dealstream_ingest_items_total{outcome=\"accepted\"}[1m]))", "legendFormat": "{{retailer}}" }
      ]
    },
    {
      "id": 2, "type": "timeseries", "title": "Feed freshness by retailer",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "time() - dealstream_ingest_last_accept_timestamp_seconds", "legendFormat": "{{retailer}}" }
      ]
    },
    {
      "id": 3, "type": "timeseries", "title": "Quarantined items/s by reason",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (outcome) (rate(dealstream_ingest_items_total{outcome!~\"accepted|stale_skipped\"}[5m]))", "legendFormat": "{{outcome}}" }
      ]
    },
    {
      "id": 4, "type": "timeseries", "title": "Feed errors and forced resyncs",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (retailer) (rate(dealstream_ingest_feed_errors_total[5m]))", "legendFormat": "{{retailer}} errors" },
        { "refId": "B", "expr": "sum by (retailer) (rate(dealstream_ingest_resyncs_total[5m]))", "legendFormat": "{{retailer}} resync" }
      ]
    },
    {
      "id": 5, "type": "timeseries", "title": "Postgres batch duration",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(dealstream_ingest_batch_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.99, sum by (le) (rate(dealstream_ingest_batch_seconds_bucket[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "ClickHouse pending rows",
      "gridPos": { "x": 0, "y": 16, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "dealstream_ch_pending_rows", "legendFormat": "pending" }
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "ClickHouse rows written/s",
      "gridPos": { "x": 8, "y": 16, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "rate(dealstream_ch_rows_written_total[1m])", "legendFormat": "rows/s" }
      ]
    },
    {
      "id": 8, "type": "timeseries", "title": "ClickHouse flushes by result",
      "gridPos": { "x": 16, "y": 16, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (result) (rate(dealstream_ch_flushes_total[5m]))", "legendFormat": "{{result}}" }
      ]
    },
    {
      "id": 9, "type": "timeseries", "title": "API latency quantiles",
      "gridPos": { "x": 0, "y": 24, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(dealstream_http_request_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(dealstream_http_request_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(dealstream_http_request_seconds_bucket[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 10, "type": "timeseries", "title": "API requests/s by route",
      "gridPos": { "x": 8, "y": 24, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (route) (rate(dealstream_http_request_seconds_count[1m]))", "legendFormat": "{{route}}" }
      ]
    },
    {
      "id": 11, "type": "timeseries", "title": "Cache hit ratio",
      "gridPos": { "x": 16, "y": 24, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1, "min": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(dealstream_cache_ops_total{result=\"hit\"}[5m])) / sum(rate(dealstream_cache_ops_total[5m]))", "legendFormat": "hit ratio" }
      ]
    },
    {
      "id": 12, "type": "timeseries", "title": "Feedgen updates/s by retailer",
      "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (retailer) (rate(dealstream_feedgen_updates_total[1m]))", "legendFormat": "{{retailer}}" }
      ]
    },
    {
      "id": 13, "type": "timeseries", "title": "Feedgen non-200 responses/s",
      "gridPos": { "x": 12, "y": 32, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prom" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (retailer, status) (rate(dealstream_feedgen_requests_total{status!=\"200\"}[5m]))", "legendFormat": "{{retailer}} {{status}}" }
      ]
    }
  ]
}
